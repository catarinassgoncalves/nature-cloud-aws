#!/bin/bash

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"

# CHANGE ACCORDINGLY

export PATH=~/aws-cli-bin:$PATH
export AWS_DEFAULT_REGION=us-east-1
export AWS_ACCOUNT_ID=REPLACE_ME
export AWS_ACCESS_KEY_ID=REPLACE_ME
export AWS_SECRET_ACCESS_KEY=REPLACE_ME

export AWS_EC2_SSH_KEYPAR_PATH=/home/vagrant/mykeypair.pem

export AWS_SECURITY_GROUP=REPLACE_ME
export AWS_KEYPAIR_NAME=mykeypair

export LOCAL_PROJECT_DIR=/home/vagrant/cnv-shared/cnvproject
export APP_PORT=8000
export HEALTHCHECK_PATH=/
export AWS_AVAILABILITY_ZONE=us-east-1a

export BUILDER_NAME=CNV-NatureCloud-Builder
export AMI_NAME=CNV-NatureCloud-Image
export ELB_NAME=CNV-NatureCloud-LB
export LAUNCH_TEMPLATE_NAME=CNV-NatureCloud-LT
export ASG_NAME=CNV-NatureCloud-ASG
export INSTANCE_TYPE=t3.micro

export MIN_SIZE=1
export MAX_SIZE=3
export DESIRED_CAPACITY=1

export HIGH_CPU_POLICY_NAME=CNV-ScaleOut-HighCPU
export LOW_CPU_POLICY_NAME=CNV-ScaleIn-LowCPU
export HIGH_CPU_ALARM_NAME=CNV-HighCPU
export LOW_CPU_ALARM_NAME=CNV-LowCPU

export CONTROLLER_NAME=NatureCloud-Controller
export CONTROLLER_INSTANCE_TYPE=t3.micro
export CONTROLLER_PORT=8080
export CONTROLLER_INSTANCE_PROFILE_NAME=CNV-NatureCloud-ControllerInstanceProfile
export CONTROLLER_SERVICE_NAME=naturecloud-controller
export CONTROLLER_LB_PORT=8080
export CONTROLLER_WORKER_ADDRESS_MODE=private
export CONTROLLER_DISCOVERED_WORKER_PORT=8000
export CONTROLLER_DISCOVERY_INTERVAL_SECONDS=15